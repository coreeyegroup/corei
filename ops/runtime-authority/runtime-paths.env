# ==================================================
# COREI RUNTIME AUTHORITY REGISTRY
# ==================================================

# ROOT
COREI_ROOT="$HOME/corei"

# ==================================================
# LIVE ACTIVATION STATE
# ==================================================

LIVE_SEMI_STATE_PATH="$COREI_ROOT/state/runtime/live-activation/live-semi/live-semi.state"

LIVE_OBSERVATION_STATE_PATH="$COREI_ROOT/state/runtime/live-activation/live-observation/live-observation.state"

LIVE_AUTO_STATE_PATH="$COREI_ROOT/state/runtime/live-activation/live-auto/live-auto.state"

BROKER_ONBOARDING_STATE_PATH="$COREI_ROOT/state/governance/broker-onboarding/broker-onboarding.state"

# ==================================================
# TELEMETRY
# ==================================================

LIVE_SEMI_LOG_PATH="$COREI_ROOT/telemetry/operations/live-semi/live-semi.log"

LIVE_OBSERVATION_LOG_PATH="$COREI_ROOT/telemetry/operations/live-observation/live-observation.log"

LIVE_AUTO_LOG_PATH="$COREI_ROOT/telemetry/operations/live-auto/live-auto.log"

BROKER_ONBOARDING_LOG_PATH="$COREI_ROOT/telemetry/operations/broker-onboarding/broker-onboarding.log"

# ==================================================
# GOVERNANCE
# ==================================================

SEMANTIC_GOVERNANCE_VALIDATOR="$COREI_ROOT/scripts/governance/validate-semantic-freeze-governance.sh"

STAGE_20_ORCHESTRATOR="$COREI_ROOT/scripts/platform/stage-20/run-stage-20.sh"

INSTALL_STATE_PATH="$COREI_ROOT/state/governance/install/install.state"
