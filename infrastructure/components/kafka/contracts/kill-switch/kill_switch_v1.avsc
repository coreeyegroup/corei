{
  "type": "record",
  "name": "KillSwitchEventV1",
  "namespace": "corei.events.kill_switch.v1",

  "fields": [

    { "name": "event_id", "type": "string" },
    { "name": "event_type", "type": "string" },
    { "name": "event_version", "type": "string" },
    { "name": "timestamp", "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "source_service", "type": "string" },
    { "name": "account_id", "type": "string" },

    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "KillSwitchPayload",

        "fields": [

          { "name": "trigger_reason", "type": "string" },
          { "name": "severity", "type": "string" },
          { "name": "global_halt", "type": "boolean" }

        ]
      }
    }

  ]
}
