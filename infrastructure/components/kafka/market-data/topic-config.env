KAFKA_BOOTSTRAP_SERVER=kafka.kafka.svc.cluster.local:9092

RAW_MARKET_DATA_TOPIC=raw_market_data_stream
NORMALIZED_MARKET_DATA_TOPIC=normalized_market_data_stream
FEATURE_STORE_TOPIC=feature_store_updates
MARKET_SESSION_TOPIC=market_session_stream
MARKET_REPLAY_TOPIC=market_replay_stream
MARKET_VALIDATION_TOPIC=market_validation_stream
MARKET_DEAD_LETTER_TOPIC=market_dead_letter_stream

PARTITIONS=6
REPLICATION_FACTOR=3

RETENTION_MS=604800000
SEGMENT_MS=86400000
