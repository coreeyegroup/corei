    max-width: 300px;

    padding: 4px;

    background: #11161d;

    border: 1px solid rgba(255,255,255,.13);
    border-radius: 3px;

    box-shadow:
        0 10px 28px rgba(0,0,0,.48),
        0 2px 6px rgba(0,0,0,.30);

    z-index: 10000;
}

.corei-ribbon-selector-menu button {
    width: 100%;
    min-height: 25px;

    display: flex;
    align-items: center;

    padding: 0 8px;

    border: 0;
    border-radius: 2px;

    background: transparent;
    color: rgba(255,255,255,.80);

    font-family: inherit;
    font-size: 10.5px;
    font-weight: 450;

    text-align: left;
    white-space: nowrap;

    cursor: pointer;
}

.corei-ribbon-selector-menu button:hover {
    background: rgba(255,255,255,.065);
    color: #fff;
}

.corei-ribbon-selector-menu button[aria-selected="true"] {
    color: #dfb45a;
    background: rgba(214,166,73,.10);
}

/* Primary status */

.corei-ribbon-primary-row .corei-ribbon-status {
    flex: 0 1 auto;

    height: 32px;

    display: flex;
    align-items: center;

    padding: 0 8px;

    border-left: 1px solid rgba(255,255,255,.035);

    box-sizing: border-box;
    white-space: nowrap;
}

.corei-ribbon-primary-row .corei-ribbon-status-label {
    font-size: 8px;
    font-weight: 550;
    letter-spacing: .055em;
}

.corei-ribbon-primary-row .corei-ribbon-status-value {
    margin-left: 5px;

    font-size: 10.5px;
    font-weight: 450;
}

/* Right command area */

.corei-ribbon-primary-spacer {
    flex: 1 1 auto;
    min-width: 8px;
}

.corei-ribbon-command {
    flex: 0 1 120px;
    width: 120px;
    min-width: 90px;

    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0 8px;

    box-sizing: border-box;
}

.corei-ribbon-clock {
    flex: 0 1 95px;
    width: 95px;
    min-width: 75px;

    height: 32px;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    padding: 0 8px;

    box-sizing: border-box;
}

/* Secondary navigation */

.corei-ribbon-tabs {
    flex: 0 0 160px;

    width: 160px;
    min-width: 120px;

    height: 26px;

    display: flex;
    align-items: stretch;

    box-sizing: border-box;
}

.corei-ribbon-tabs button {
    flex: 1 1 auto;

    height: 26px;

    padding: 0 9px;

    border: 0;
    border-bottom: 2px solid transparent;

    background: transparent;

    color: rgba(255,255,255,.58);

    font-family: inherit;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .045em;

    cursor: pointer;
}

.corei-ribbon-tabs button:hover {
    color: rgba(255,255,255,.90);
    background: rgba(255,255,255,.025);
}

/* Secondary operating information */

.corei-ribbon-secondary-content {
    flex: 1 1 auto;

    width: auto;
    min-width: 0;
    max-width: 100%;

    height: 26px;

    display: flex;

    overflow: hidden;
}

.corei-ribbon-secondary-content .corei-ribbon-status {
    flex: 1 1 0;
    min-width: 0;

    height: 26px;

    display: flex;
    align-items: center;

    padding: 0 10px;

    border-right: 1px solid rgba(255,255,255,.045);

    box-sizing: border-box;
    overflow: hidden;
}

.corei-ribbon-secondary-content .corei-ribbon-status-label {
    flex: 0 0 auto;

    font-size: 8px;
    font-weight: 550;
    letter-spacing: .05em;
}

.corei-ribbon-secondary-content .corei-ribbon-status-value {
    min-width: 0;

    margin-left: 6px;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    font-size: 10px;
    font-weight: 450;
}
