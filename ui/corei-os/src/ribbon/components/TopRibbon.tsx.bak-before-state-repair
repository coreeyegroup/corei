interface StatusProps {
    readonly label: string;
    readonly value: string;
    readonly tone?: "operational" | "attention" | "critical" | "neutral";
    readonly subtext?: string;
}


function Status({
    label,
    value,
    tone = "neutral",
    subtext
}: StatusProps): ReactElement {
    return (
        <div
            className="corei-ribbon-status"
            data-status-tone={tone}
        >
            <span className="corei-ribbon-status-label">
                {label}
            </span>

            <span className="corei-ribbon-status-value">
                {tone !== "neutral" && (
                    <i aria-hidden="true" />
                )}
                {value}
                {subtext && (
                    <span className="corei-ribbon-status-sub">
                        {subtext}
                    </span>
                )}
            </span>
        </div>
    );
}


function Clock(): ReactElement {
    const [now, setNow] = useState(() => new Date());

    useEffect(() => {
        const timer = window.setInterval(
            () => setNow(new Date()),
            1000
        );
        return () => window.clearInterval(timer);
    }, []);

    return (
        <div
            className="corei-ribbon-clock"
            data-ribbon-block="clock"
        >
            <span className="corei-ribbon-clock-time">
                {now.toLocaleTimeString(undefined, {
                    hour12: false,
                    hour: "2-digit",
                    minute: "2-digit",
                    second: "2-digit"
                })}
            </span>

            <span className="corei-ribbon-clock-zone">
                IST
            </span>
        </div>
    );
}


interface SelectorProps {
    readonly label: string;
    readonly value: string;
    readonly children: ReactElement[];
    readonly onChange: (value: string) => void;
}


function RibbonSelector({
    label,
    value,
    children,
    onChange
}: SelectorProps): ReactElement {

    const [open, setOpen] = useState(false);

    const rootRef =
        useRef<HTMLDivElement>(null);

    const options =
        children.map((child) => {

            const option =
                child as ReactElement<{
                    value?: string;
                    children?: unknown;
                }>;

            return {
                value: String(option.props.value ?? ""),
                label: String(option.props.children ?? "")
            };
        });

    const selected =
        options.find(
            (option) =>
                option.value === value
        );

    useEffect(() => {

        const handlePointerDown =
            (event: MouseEvent) => {

                if (
                    rootRef.current &&
                    !rootRef.current.contains(
                        event.target as Node
                    )
                ) {
                    setOpen(false);
                }
            };

        const handleKeyDown =
            (event: KeyboardEvent) => {

                if (event.key === "Escape") {
                    setOpen(false);
                }
            };

        document.addEventListener(
            "mousedown",
            handlePointerDown
        );

        document.addEventListener(
            "keydown",
            handleKeyDown
        );

        return () => {
            document.removeEventListener(
                "mousedown",
                handlePointerDown
            );

            document.removeEventListener(
                "keydown",
                handleKeyDown
            );
        };

    }, []);

    const select =
        (nextValue: string) => {

            setOpen(false);

            if (nextValue !== value) {
                onChange(nextValue);
            }
        };

    return (
        <div
            ref={rootRef}
            className="corei-ribbon-selector"
            data-ribbon-block={
                label.toLowerCase()
            }
        >

            <button
                type="button"
                className="corei-ribbon-selector-trigger"
                aria-label={label}
                aria-haspopup="listbox"
                aria-expanded={open}
                onClick={() =>
                    setOpen((current) => !current)
                }
            >

                <span className="corei-ribbon-selector-label">
                    {label}
                </span>

                <span className="corei-ribbon-selector-value">
                    {selected?.label ?? value}
                </span>

                <span
                    className="corei-ribbon-selector-chevron"
                    aria-hidden="true"
                >
                    ▾
                </span>

            </button>

            {open && (
                <div
                    className="corei-ribbon-selector-menu"
                    role="listbox"
                    aria-label={`${label} options`}
                >

                    <div className="corei-ribbon-selector-menu-header">
                        {label}
                        <span>
                            {options.length}
                        </span>
                    </div>

                    {options.map((option) => (

                        <button
                            key={option.value}
                            type="button"
                            role="option"
                            aria-selected={
                                option.value === value
                            }
                            className={
                                option.value === value
                                    ? "selected"
                                    : ""
                            }
                            onClick={() =>
                                select(option.value)
                            }
                        >

                            <span>
                                {option.label}
                            </span>

                            {option.value === value && (
                                <span
                                    aria-hidden="true"
                                    className="corei-ribbon-selector-check"
                                >
                                    ✓
                                </span>
                            )}

                        </button>

                    ))}

                </div>
            )}

        </div>
    );
}



// ── Helper: status label from health string ──
function statusLabel(status: string): string {
    switch (status) {
        case "healthy": return "CONNECTED";
        case "degraded": return "DEGRADED";
        case "critical": return "CRITICAL";
        case "offline": return "OFFLINE";
        default: return "UNAVAILABLE";
    }
}


// ── Helper: tone from health string ──
function statusTone(status: string): "operational" | "attention" | "critical" | "neutral" {
    switch (status) {
        case "healthy": return "operational";
        case "degraded": return "attention";
        case "critical": return "critical";
        case "offline": return "critical";
        default: return "neutral";
    }
}


