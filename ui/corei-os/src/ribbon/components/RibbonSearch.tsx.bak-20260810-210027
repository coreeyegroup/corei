import {
    useEffect,
    useRef,
    useState,
    type ReactElement
} from "react";


const SEARCH_ENTRIES = [
    "Search commands",
    "Find workspace",
    "Find module",
    "Find panel",
    "Find market",
    "Find trading",
    "Find infrastructure",
    "Find settings"
];


export function RibbonSearch(): ReactElement {

    const [query, setQuery] =
        useState("");

    const [open, setOpen] =
        useState(false);

    const inputRef =
        useRef<HTMLInputElement>(null);

    const filtered =
        SEARCH_ENTRIES.filter(
            (entry) =>
                entry
                    .toLowerCase()
                    .includes(
                        query.trim().toLowerCase()
                    )
        );

    useEffect(() => {

        const handleKeyDown =
            (event: KeyboardEvent) => {

                if (
                    (event.metaKey || event.ctrlKey) &&
                    event.key.toLowerCase() === "k"
                ) {

                    event.preventDefault();

                    inputRef.current?.focus();

                    setOpen(true);
                }

                if (event.key === "Escape") {
                    setOpen(false);
                }
            };

        window.addEventListener(
            "keydown",
            handleKeyDown
        );

        return () =>
            window.removeEventListener(
                "keydown",
                handleKeyDown
            );

    }, []);

    return (
        <div
            className="corei-ribbon-search"
            data-ribbon-block="search"
        >

            <span
                className="corei-ribbon-search-icon"
                aria-hidden="true"
            >
                /
            </span>

            <input
                ref={inputRef}
                type="search"
                value={query}
                placeholder="Search / Find"
                aria-label="COREI global search"
                onFocus={() =>
                    setOpen(true)
                }
                onChange={(event) => {
                    setQuery(event.target.value);
                    setOpen(true);
                }}
                onKeyDown={(event) => {

                    if (event.key === "Escape") {
                        setOpen(false);
                        inputRef.current?.blur();
                    }

                    if (
                        event.key === "Enter" &&
                        filtered.length > 0
                    ) {
                        setQuery(filtered[0]);
                        setOpen(false);
                    }
                }}
            />

            <kbd>⌘K</kbd>

            {open && (
                <div
                    className="corei-ribbon-search-menu"
                    role="listbox"
                    aria-label="Search suggestions"
                >

                    <div className="corei-ribbon-search-menu-header">
                        FIND / COMMAND
                    </div>

                    {filtered.length === 0 ? (

                        <div className="corei-ribbon-search-empty">
                            No matching commands
                        </div>

                    ) : (

                        filtered.map((entry) => (

                            <button
                                key={entry}
                                type="button"
                                onMouseDown={(event) =>
                                    event.preventDefault()
                                }
                                onClick={() => {
                                    setQuery(entry);
                                    setOpen(false);
                                }}
                            >
                                <span>
                                    {entry}
                                </span>

                                <span>
                                    ↵
                                </span>
                            </button>

                        ))

                    )}

                </div>
            )}

        </div>
    );
}


export default RibbonSearch;
