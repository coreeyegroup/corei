/*
 * COREI OPERATING SYSTEM
 *
 * STAGE-25
 * SHELL SURFACE NORMALIZATION
 *
 * Purpose:
 * Normalize the existing shell regions without changing
 * ownership, geometry, runtime composition, or providers.
 */

.corei-region {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    overflow: hidden;

    display: flex;
    flex-direction: column;

    box-sizing: border-box;

    background:
        var(--corei-color-surface-primary);

    color:
        var(--corei-color-text-primary);

    font-family:
        var(--corei-font-family);

    font-size:
        var(--corei-font-size-small);
}

/*
 * REGION OWNERSHIP
 */

.shell-top {
    grid-area: top;
    border-bottom:
        1px solid
        var(--corei-color-border-subtle, rgba(255, 255, 255, 0.08));
}

.shell-left {
    grid-area: left;
    border-right:
        1px solid
        var(--corei-color-border-subtle, rgba(255, 255, 255, 0.08));
}

.shell-center {
    grid-area: center;
}

.shell-right {
    grid-area: right;
    border-left:
        1px solid
        var(--corei-color-border-subtle, rgba(255, 255, 255, 0.08));
}

.shell-bottom {
    grid-area: bottom;
    border-top:
        1px solid
        var(--corei-color-border-subtle, rgba(255, 255, 255, 0.08));
}

.shell-status {
    grid-area: status;
    border-top:
        1px solid
        var(--corei-color-border-subtle, rgba(255, 255, 255, 0.08));
}

/*
 * REGION SURFACE
 */

.corei-region-surface {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    padding:
        var(--corei-spacing-sm);

    display: flex;
    align-items: center;

    overflow: hidden;

    box-sizing: border-box;
}

.corei-region-surface span {
    font-size:
        var(--corei-font-size-small);

    letter-spacing:
        0.08em;

    text-transform:
        uppercase;

    white-space: nowrap;
}

/*
 * LEFT NAVIGATION
 */

.corei-left-navigation-container {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    display: flex;

    overflow: hidden;

    box-sizing: border-box;
}

/*
 * SURFACE CONTENT SAFETY
 */

.corei-region > *,
.corei-region-surface > * {
    min-width: 0;
    min-height: 0;
}
