/* src/components/Workspace/views/trading/BrokerIntelligence.css */

.broker-intelligence {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg-primary, #0d1117);
  color: var(--text-primary, #d9dde5);
  font-family: var(--corei-font-family, Inter, "Segoe UI", system-ui, sans-serif);
  font-variant-numeric: tabular-nums;
}

/* ─── COMPACT HEADER (32px Height) ─────────────────────────────────── */
.bi-command-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  height: 36px; /* Increased slightly from 32px to fit path */
  padding: 0 10px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  background: rgba(15,21,30,.96);
}

.bi-command-identity {
  display: flex;
  align-items: baseline; /* Align text on baseline */
  gap: 8px;
  min-width: 0;
}

.bi-eyebrow {
  display: block;
  color: rgba(255,255,255,.40);
  font-size: 8px;
  line-height: 10px;
  letter-spacing: .09em;
  font-weight: 600;
  white-space: nowrap;
}

.bi-command-identity h2 {
  margin: 0;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.02em;
}

.bi-command-subtitle {
  display: block;
  color: rgba(255,255,255,.43);
  font-size: 8px;
  line-height: 10px;
  white-space: nowrap;
}

.bi-command-state {
  display: flex;
  gap: 12px;
  font-size: 10px;
  color: rgba(255,255,255,.60);
}
.bi-command-state div { display: flex; align-items: center; gap: 4px; }
.bi-command-state span { font-size: 8px; letter-spacing: .08em; }
.bi-command-state strong { font-size: 12px; color: var(--text-primary); font-weight: 700; }
.bi-command-state strong[data-tone="warning"] { color: #d3aa58; }

.bi-command-actions { display: flex; align-items: center; gap: 6px; padding: 0; }
.bi-auto-refresh { display: flex; align-items: center; gap: 5px; color: rgba(255,255,255,.48); font-size: 9px; white-space: nowrap; }
.bi-auto-refresh input { accent-color: currentColor; }

.bi-btn, .bi-table-action, .bi-control-action, .bi-icon-button {
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.025);
  color: rgba(255,255,255,.72);
  cursor: pointer;
  font: inherit;
}
.bi-btn { min-height: 24px; padding: 0 8px; border-radius: 3px; font-size: 9px; letter-spacing: .05em; }
.bi-btn:hover, .bi-table-action:hover { background: rgba(255,255,255,.055); color: rgba(255,255,255,.92); }
.bi-btn:disabled, .bi-table-action:disabled, .bi-control-action:disabled { cursor: not-allowed; opacity: .45; }

/* ─── Tabs ─────────────────────────────────────────────────────────── */
.bi-tab-strip {
  display: flex; min-width: 0; overflow-x: auto; overflow-y: hidden;
  background: rgba(11,15,20,.98); border-bottom: 1px solid rgba(255,255,255,.08);
  scrollbar-width: thin;
}
.bi-tab-strip button {
  flex: 0 0 auto; min-height: 28px; padding: 0 11px; border: 0;
  border-right: 1px solid rgba(255,255,255,.045); background: transparent;
  color: rgba(255,255,255,.43); font: 500 9px/12px inherit; letter-spacing: .04em;
  cursor: pointer; white-space: nowrap;
}
.bi-tab-strip button:hover { background: rgba(255,255,255,.025); color: rgba(255,255,255,.78); }
.bi-tab-strip button.active { color: rgba(255,255,255,.92); background: rgba(255,255,255,.045); box-shadow: inset 0 -2px 0 rgba(211,170,88,.9); }

/* ─── Control Strip ────────────────────────────────────────────────── */
.bi-control-strip {
  display: flex; align-items: center; gap: 6px; min-width: 0; padding: 6px 8px;
  border-bottom: 1px solid rgba(255,255,255,.06); background: rgba(13,17,23,.96);
}
.bi-search { flex: 1 1 280px; min-width: 120px; }
.bi-search input, .bi-control-strip select {
  width: 100%; min-width: 0; height: 24px; box-sizing: border-box;
  border: 1px solid rgba(255,255,255,.09); border-radius: 2px; outline: none;
  background: rgba(255,255,255,.025); color: rgba(255,255,255,.72); padding: 0 8px;
  font: 400 10px/12px inherit;
}
.bi-control-strip select { width: 150px; flex: 0 0 150px; }
.bi-search input:focus, .bi-control-strip select:focus { border-color: rgba(211,170,88,.55); }
.bi-state-summary { flex: 0 0 auto; min-width: 92px; color: rgba(255,255,255,.42); font-size: 8px; text-align: right; letter-spacing: .07em; }

/* ─── Content & Views ──────────────────────────────────────────────── */
.bi-content { position: relative; flex: 1 1 auto; min-width: 0; min-height: 0; overflow: auto; }
.bi-view { display: flex; flex-direction: column; gap: 8px; min-width: 0; padding: 8px; box-sizing: border-box; }
.bi-two-column { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, .8fr); }

.bi-summary-strip { display: grid; grid-template-columns: repeat(7, minmax(80px, 1fr)); min-width: 0; border: 1px solid rgba(255,255,255,.07); background: rgba(255,255,255,.012); }
.bi-metric { min-width: 0; padding: 9px 11px; border-right: 1px solid rgba(255,255,255,.055); }
.bi-metric:last-child { border-right: 0; }
.bi-metric-label { display: block; color: rgba(255,255,255,.36); font-size: 8px; line-height: 10px; letter-spacing: .08em; }
.bi-metric-value { display: block; margin-top: 4px; color: rgba(255,255,255,.84); font-size: 17px; line-height: 19px; font-weight: 500; }
.bi-metric-value[data-tone="operational"] { color: #79c56a; }
.bi-metric-value[data-tone="warning"] { color: #d3aa58; }

.bi-overview-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; min-width: 0; }
.bi-panel { min-width: 0; border: 1px solid rgba(255,255,255,.07); background: rgba(15,21,30,.72); overflow: hidden; }
.bi-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-width: 0; min-height: 42px; padding: 6px 10px; border-bottom: 1px solid rgba(255,255,255,.055); }
.bi-panel-header h3 { margin: 2px 0 0; color: rgba(255,255,255,.83); font-size: 12px; line-height: 15px; font-weight: 500; }
.bi-security-note { color: rgba(121,197,106,.72); font-size: 8px; letter-spacing: .07em; }

.bi-table-wrap { width: 100%; max-width: 100%; overflow-x: auto; overflow-y: hidden; }
.bi-table { width: 100%; min-width: 720px; border-collapse: collapse; table-layout: auto; }
.bi-table th { height: 24px; padding: 0 9px; border-bottom: 1px solid rgba(255,255,255,.06); background: rgba(255,255,255,.015); color: rgba(255,255,255,.34); font-size: 8px; line-height: 10px; font-weight: 600; letter-spacing: .07em; text-align: left; white-space: nowrap; }
.bi-table td { height: 30px; padding: 0 9px; border-bottom: 1px solid rgba(255,255,255,.045); color: rgba(255,255,255,.56); font-size: 9px; line-height: 12px; white-space: nowrap; }
.bi-table tbody tr { cursor: pointer; }
.bi-table tbody tr:hover { background: rgba(255,255,255,.025); }
.bi-primary-cell { color: rgba(255,255,255,.82) !important; font-weight: 500; }
.bi-table-action { min-height: 20px; padding: 0 7px; border-radius: 2px; font-size: 8px; letter-spacing: .04em; }
.bi-table-action.danger { color: rgba(212,92,92,.85); }

.bi-state-badge { display: inline-flex; align-items: center; gap: 5px; color: rgba(255,255,255,.54); font-size: 8px; line-height: 10px; letter-spacing: .04em; }
.bi-state-badge i { width: 5px; height: 5px; flex: 0 0 5px; border-radius: 50%; background: rgba(255,255,255,.28); }
.bi-state-badge[data-tone="operational"] i { background: #79c56a; }
.bi-state-badge[data-tone="warning"] i { background: #d3aa58; }
.bi-state-badge[data-tone="critical"] i { background: #d45c5c; }
.bi-state-badge[data-tone="disabled"] i { background: rgba(255,255,255,.22); }
.bi-environment { font-size: 8px; letter-spacing: .05em; }

/* ─── Flow, Lifecycle, Controls ────────────────────────────────────── */
.bi-flow-panel { padding-bottom: 8px; }
.bi-architecture-flow { display: grid; grid-template-columns: minmax(120px,1fr) 30px minmax(120px,1fr) 30px minmax(120px,1fr) 30px minmax(120px,1fr); align-items: center; gap: 4px; padding: 12px; }
.bi-architecture-flow > div { min-width: 0; padding: 10px; border: 1px solid rgba(255,255,255,.065); background: rgba(255,255,255,.015); }
.bi-architecture-flow span { display: block; color: rgba(255,255,255,.35); font-size: 8px; letter-spacing: .08em; }
.bi-architecture-flow strong { display: block; margin-top: 5px; color: rgba(255,255,255,.72); font-size: 10px; line-height: 13px; font-weight: 500; }
.bi-architecture-flow i { color: rgba(255,255,255,.28); text-align: center; font-style: normal; }

.bi-lifecycle { display: flex; flex-direction: column; padding: 8px; }
.bi-lifecycle-step { display: grid; grid-template-columns: 32px 1fr; min-height: 30px; align-items: center; border-bottom: 1px solid rgba(255,255,255,.045); }
.bi-lifecycle-step span { color: rgba(255,255,255,.30); font-size: 8px; }
.bi-lifecycle-step strong { color: rgba(255,255,255,.65); font-size: 9px; font-weight: 500; }

.bi-control-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 8px; }
.bi-control-block { min-width: 0; padding: 12px; border: 1px solid rgba(255,255,255,.065); background: rgba(255,255,255,.012); }
.bi-control-block[data-critical="true"] { border-color: rgba(212,92,92,.18); }
.bi-control-block p { max-width: 650px; margin: 6px 0 10px; color: rgba(255,255,255,.43); font-size: 9px; line-height: 13px; }
.bi-control-actions { display: flex; flex-wrap: wrap; gap: 5px; }
.bi-control-action { min-height: 22px; padding: 0 8px; font-size: 8px; letter-spacing: .04em; }
.bi-control-action.critical { border-color: rgba(212,92,92,.18); }

.bi-state { display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 6px; min-height: 160px; padding: 20px; box-sizing: border-box; color: rgba(255,255,255,.42); text-align: center; }
.bi-state strong { color: rgba(255,255,255,.68); font-size: 10px; letter-spacing: .07em; }
.bi-state span { max-width: 560px; font-size: 9px; line-height: 13px; }
.bi-error-state strong { color: #d45c5c; }

/* ─── Inspector ────────────────────────────────────────────────────── */
.bi-inspector { position: absolute; top: 0; right: 0; z-index: 20; display: flex; flex-direction: column; width: min(420px, 45%); height: 100%; min-width: 300px; box-sizing: border-box; border-left: 1px solid rgba(255,255,255,.09); background: #11151b; box-shadow: -12px 0 30px rgba(0,0,0,.30); }
.bi-inspector-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; padding: 12px; border-bottom: 1px solid rgba(255,255,255,.07); }
.bi-inspector-header h3 { margin: 3px 0 0; color: rgba(255,255,255,.87); font-size: 13px; line-height: 16px; font-weight: 500; }
.bi-icon-button { width: 26px; height: 26px; padding: 0; font-size: 17px; line-height: 24px; }
.bi-inspector-body { min-height: 0; overflow-y: auto; padding: 8px 12px; }
.bi-inspector-row { display: grid; grid-template-columns: minmax(100px,.8fr) minmax(120px,1.2fr); gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.045); }
.bi-inspector-row span { color: rgba(255,255,255,.32); font-size: 8px; line-height: 11px; }
.bi-inspector-row strong { min-width: 0; overflow-wrap: anywhere; color: rgba(255,255,255,.68); font-size: 9px; line-height: 12px; font-weight: 400; }

/* ─── Responsive ───────────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .bi-summary-strip { grid-template-columns: repeat(4, minmax(80px,1fr)); }
  .bi-overview-grid, .bi-two-column, .bi-control-grid { grid-template-columns: minmax(0,1fr); }
  .bi-architecture-flow { grid-template-columns: 1fr; }
  .bi-architecture-flow i { transform: rotate(90deg); }
}
@media (max-width: 760px) {
  .bi-command-header { flex-wrap: wrap; }
  .bi-command-identity { flex: 1 1 100%; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.06); }
  .bi-command-state { overflow-x: auto; }
  .bi-command-actions { padding: 6px 8px; }
  .bi-control-strip { flex-wrap: wrap; }
  .bi-search { flex-basis: 100%; }
  .bi-control-strip select { flex: 1 1 130px; width: auto; }
  .bi-inspector { width: 100%; min-width: 0; }
}
