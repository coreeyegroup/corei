const MarketIntelligence: React.FC<
  MarketIntelligenceProps
> = ({ section = 'overview' }) => {
  const instruments = useMarketStore(
    (state) => state.instruments,
  ) as Record<string, Instrument>;

  const loading = useMarketStore(
    (state) => state.loading,
  );

  const error = useMarketStore(
    (state) => state.error,
  );

  const fetchData = useMarketStore(
    (state) => state.fetchData,
  );

  const [selectedSymbol, setSelectedSymbol] =
    useState('');

  const [search, setSearch] = useState('');

  const observations = useMemo<Observation[]>(() => {
    return Object.entries(instruments)
      .map(([symbol, data]) => ({
        symbol,
        price: data?.price ?? 0,
        change: data?.change ?? 0,
        historyLength: data?.history?.length ?? 0,
        direction: directionForChange(data?.change ?? 0),
      }))
      .sort((a, b) =>
        a.symbol.localeCompare(b.symbol),
      );
  }, [instruments]);

  const filteredObservations = useMemo(() => {
    const query = search.trim().toLowerCase();

    if (!query) return observations;

    return observations.filter((item) =>
      item.symbol.toLowerCase().includes(query),
    );
  }, [observations, search]);

  const effectiveSelectedSymbol =
    selectedSymbol &&
    observations.some(
      (item) => item.symbol === selectedSymbol,
    )
      ? selectedSymbol
      : observations[0]?.symbol ?? '';

  const meta = SECTION_META[section];

  const handleRefresh = () => {
    void fetchData();
  };

  const renderSection = () => {
    if (section === 'overview') {
      return (
        <OverviewSection
          observations={filteredObservations}
          selectedSymbol={effectiveSelectedSymbol}
          onSelect={setSelectedSymbol}
          error={error}
        />
      );
    }

    if (section === 'market-data') {
      return (
        <MarketDataSection
          observations={filteredObservations}
          selectedSymbol={effectiveSelectedSymbol}
          onSelect={setSelectedSymbol}
        />
      );
    }

    if (section === 'market-health') {
      return (
        <MarketHealthSection
          observations={filteredObservations}
          loading={loading}
          error={error}
        />
      );
    }

    if (ANALYTICAL_SECTIONS.includes(section)) {
      const descriptions: Record<
        MarketIntelligenceSection,
        string
      > = {
        overview: '',
        'market-data': '',
        'market-health': '',
        technical:
          'Technical measurements must be supplied by authoritative analytical state rather than reconstructed inside the UI.',
        structure:
          'Market structure requires governed structural analytics including price, liquidity and relationship state.',
        trend:
          'Trend interpretation requires authoritative directional and timeframe state.',
        volatility:
          'Volatility interpretation requires authoritative volatility measurements and transition state.',
        momentum:
          'Momentum interpretation requires authoritative momentum measurements and directional state.',
        regime:
          'Regime state must originate from the governed market-context / regime authority.',
      };

      return (
        <NotExposed
          title={meta.title}
          description={descriptions[section]}
          dependency={
            section === 'regime'
              ? 'market-regime / market-context authority'
              : `${meta.title.toLowerCase()} analytical authority`
          }
        />
      );
    }

    return null;
  };

  return (
    <div className="market-intelligence-root">
      <header className="mi-workspace-header">
        <div className="mi-title-block">
          <div className="mi-title-line">
            <span className="mi-system-mark">
              COREI
            </span>

            <span className="mi-title-separator">
              /
            </span>

            <span className="mi-layer">
              {meta.layer}
            </span>
          </div>

          <h2>{meta.title}</h2>

          <p>{meta.subtitle}</p>
        </div>

        <div className="mi-header-controls">
          <div className="mi-authority-state">
            <span>AUTHORITY</span>
            <strong>
              {error ? 'DEGRADED' : 'OBSERVATION'}
            </strong>
          </div>

          <button
            type="button"
            className="mi-icon-button"
            onClick={handleRefresh}
            title="Refresh market observations"
          >
            <RefreshCw
              size={14}
              className={
                loading
                  ? 'mi-refresh-spinning'
                  : undefined
              }
            />
          </button>
        </div>
      </header>

      <div className="mi-toolbar">
        <div className="mi-search">
          <Search size={13} />

          <input
            value={search}
            onChange={(event) =>
              setSearch(event.target.value)
            }
            placeholder="Search observed instruments"
            aria-label="Search observed instruments"
          />

          {search && (
            <button
              type="button"
              onClick={() => setSearch('')}
              aria-label="Clear search"
            >
              <X size={12} />
            </button>
          )}
        </div>

        <div className="mi-toolbar-context">
          <span>
            {filteredObservations.length} observed
          </span>

          <span className="mi-toolbar-divider" />

          <span>
            {effectiveSelectedSymbol || 'NO SELECTION'}
          </span>
        </div>
      </div>

      {renderSection()}

      <footer className="mi-workspace-footer">
        <div>
          <ShieldCheck size={12} />
          <span>
            READ-ONLY INTELLIGENCE SURFACE
          </span>
        </div>

        <div>
          <History size={12} />
          <span>REPLAY AUTHORITY: GOVERNED</span>
        </div>

        <div>
          <BarChart3 size={12} />
          <span>
            ANALYTICS AUTHORITY: BACKEND
          </span>
        </div>
      </footer>
    </div>
  );
};

export default MarketIntelligence;
