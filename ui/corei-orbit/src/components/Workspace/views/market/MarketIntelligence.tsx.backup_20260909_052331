const StateColumn: React.FC<{
  observations: Observation[];
  selectedSymbol: string;
}> = ({ observations, selectedSymbol }) => {
  const selected = observations.find(
    (item) => item.symbol === selectedSymbol,
  );

  const positive = observations.filter(
    (item) => item.change > 0,
  ).length;

  const negative = observations.filter(
    (item) => item.change < 0,
  ).length;

  const flat = observations.length - positive - negative;

  return (
    <section className="mi-card">
      <div className="mi-card-header">
        <div>
          <span className="mi-eyebrow">02 / STATE</span>
          <h3>Observable State</h3>
        </div>

        <AuthorityBadge>DERIVED</AuthorityBadge>
      </div>

      <div className="mi-card-description">
        State derived only from currently available observations.
      </div>

      <div className="mi-state-focus">
        <span className="mi-state-focus-label">
          Selected observation
        </span>

        <strong>
          {selected?.symbol ?? 'NO SELECTION'}
        </strong>

        <span
          className={`mi-state-focus-value ${
            selected && selected.change > 0
              ? 'mi-positive'
              : selected && selected.change < 0
                ? 'mi-negative'
                : 'mi-neutral'
          }`}
        >
          {selected
            ? formatChange(selected.change)
            : '—'}
        </span>
      </div>

      <div className="mi-state-grid">
        <div>
          <span>Observed</span>
          <strong>{observations.length}</strong>
        </div>

        <div>
          <span>Positive</span>
          <strong className="mi-positive">{positive}</strong>
        </div>

        <div>
          <span>Negative</span>
          <strong className="mi-negative">{negative}</strong>
        </div>

        <div>
          <span>Flat</span>
          <strong>{flat}</strong>
        </div>
      </div>

      <div className="mi-state-rule">
        <span>STATE AUTHORITY</span>
        <strong>
          Observation-derived only
