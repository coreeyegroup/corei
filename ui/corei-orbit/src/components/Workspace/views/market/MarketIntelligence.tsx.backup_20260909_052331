      <div className="mi-discovery-list">
        {movers.length === 0 ? (
          <div className="mi-empty">
            Discovery requires available observations.
          </div>
        ) : (
          movers.map((item) => (
            <div
              className="mi-discovery-row"
              key={item.symbol}
            >
              <span>{item.symbol}</span>

              <span
                className={
                  item.change > 0
                    ? 'mi-positive'
                    : item.change < 0
                      ? 'mi-negative'
                      : 'mi-neutral'
                }
              >
                {formatChange(item.change)}
              </span>
            </div>
          ))
