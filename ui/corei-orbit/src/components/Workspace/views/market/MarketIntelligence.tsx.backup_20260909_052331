const MarketObservationRow: React.FC<{
  observation: Observation;
  selected: boolean;
  onSelect: () => void;
}> = ({ observation, selected, onSelect }) => {
  const directionClass =
    observation.direction === 'UP'
      ? 'mi-positive'
      : observation.direction === 'DOWN'
        ? 'mi-negative'
        : 'mi-neutral';

  return (
    <button
      type="button"
      className={`mi-observation-row ${
        selected ? 'mi-observation-row-selected' : ''
      }`}
      onClick={onSelect}
    >
      <span className="mi-observation-symbol">
        {observation.symbol}
      </span>

      <span className="mi-observation-price">
        {formatPrice(observation.price)}
      </span>

      <span className={`mi-observation-change ${directionClass}`}>
        {observation.direction === 'UP' && (
          <ArrowUpRight size={12} />
        )}

        {observation.direction === 'DOWN' && (
          <ArrowDownRight size={12} />
        )}

        {formatChange(observation.change)}
      </span>

      <span className="mi-observation-history">
        {observation.historyLength > 0
          ? `${observation.historyLength} observations`
          : 'No history'}
      </span>

      <ChevronRight size={13} className="mi-row-chevron" />
    </button>
  );
};

