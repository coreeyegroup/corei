}> = ({ observations }) => {
  const movers = useMemo(
    () =>
      [...observations]
        .sort(
          (a, b) =>
            Math.abs(b.change) - Math.abs(a.change),
        )
        .slice(0, 5),
    [observations],
  );

  return (
    <section className="mi-card mi-discovery-card">
      <div className="mi-card-header">
        <div>
          <span className="mi-eyebrow">03 / DISCOVERY</span>
