:root {
  --mi-bg: var(--trading-bg, #071017);
  --mi-surface: var(--panel-bg, #0b151d);
  --mi-surface-2: #0d1a23;
  --mi-border: rgba(128, 164, 184, 0.18);
  --mi-border-strong: rgba(128, 164, 184, 0.30);
  --mi-text: #dbe7ed;
  --mi-muted: #7f949f;
  --mi-accent: #16d9b0;
  --mi-positive: #18d9a6;
  --mi-negative: #ff5b68;
  --mi-amber: #e7b34b;
}

.market-intelligence-root {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  padding: 10px 12px 28px;
  background:
    linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.014) 1px, transparent 1px),
    var(--mi-bg);
  background-size: 24px 24px;
  color: var(--mi-text);
  font-size: 11px;
  overflow: auto;
}

.mi-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}

.mi-header-copy {
  min-width: 0;
}

.mi-kicker {
  display: flex;
  align-items: center;
  gap: 5px;
  color: var(--mi-accent);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .12em;
}

.mi-header h1 {
  margin: 2px 0 1px;
  font-size: 18px;
  line-height: 1.1;
  font-weight: 700;
  letter-spacing: -.01em;
}

.mi-header p {
  margin: 0;
  color: var(--mi-muted);
  font-size: 10px;
}

.mi-header-actions,
.mi-chart-tools {
  display: flex;
  align-items: center;
  gap: 5px;
}

.mi-authority-chip,
.mi-state,
.mi-count {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 18px;
  padding: 0 6px;
  border: 1px solid var(--mi-border);
  border-radius: 3px;
  color: var(--mi-muted);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .06em;
  white-space: nowrap;
}

.mi-authority-chip {
  color: var(--mi-accent);
  border-color: rgba(22, 217, 176, .24);
  background: rgba(22, 217, 176, .04);
}

.mi-state-live {
  color: var(--mi-positive);
  border-color: rgba(24, 217, 166, .24);
  background: rgba(24, 217, 166, .045);
}

.mi-state-error {
  color: var(--mi-negative);
  border-color: rgba(255, 91, 104, .28);
  background: rgba(255, 91, 104, .045);
}

.mi-state-neutral {
  color: #8ea0aa;
  background: rgba(142, 160, 170, .035);
}

.mi-positive { color: var(--mi-positive) !important; }
.mi-negative { color: var(--mi-negative) !important; }

.mi-icon-button,
.mi-mini-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--mi-border);
  background: var(--mi-surface);
  color: #a8bbc4;
  border-radius: 3px;
  cursor: pointer;
}

.mi-icon-button {
  width: 27px;
  height: 24px;
}

.mi-mini-button {
  width: 21px;
  height: 18px;
}

.mi-icon-button:hover,
.mi-mini-button:hover {
  border-color: var(--mi-border-strong);
  color: var(--mi-text);
}

.mi-spin {
  animation: mi-spin .8s linear infinite;
}

@keyframes mi-spin {
  to { transform: rotate(360deg); }
}

.mi-control-bar {
  display: flex;
  align-items: center;
  gap: 5px;
  min-height: 34px;
  padding: 4px;
  border: 1px solid var(--mi-border);
  background: rgba(7, 16, 23, .92);
  border-radius: 4px;
}

.mi-search {
  display: flex;
  align-items: center;
  gap: 5px;
  width: 190px;
  height: 25px;
  padding: 0 7px;
  border: 1px solid var(--mi-border);
  border-radius: 3px;
  color: var(--mi-muted);
  background: var(--mi-surface);
}

.mi-search input {
  min-width: 0;
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--mi-text);
  font-size: 10px;
}

.mi-search button {
  border: 0;
  padding: 0;
  background: transparent;
  color: var(--mi-muted);
  cursor: pointer;
}

.mi-select-control {
  position: relative;
  display: flex;
  align-items: center;
  gap: 5px;
  height: 25px;
  padding: 0 19px 0 7px;
  border: 1px solid var(--mi-border);
  background: var(--mi-surface);
  border-radius: 3px;
}

.mi-select-control span {
  color: var(--mi-muted);
  font-size: 7px;
  font-weight: 800;
}

.mi-select-control select {
  appearance: none;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--mi-text);
  font-size: 10px;
  cursor: pointer;
}

.mi-select-control svg {
  position: absolute;
  right: 5px;
  pointer-events: none;
  color: var(--mi-muted);
}

.mi-segmented {
  display: flex;
  height: 25px;
  border: 1px solid var(--mi-border);
  border-radius: 3px;
  overflow: hidden;
}

.mi-segmented button,
.mi-density,
.mi-toggle,
.mi-secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 25px;
  padding: 0 8px;
  border: 0;
  background: var(--mi-surface);
  color: #8ea2ac;
  font-size: 9px;
  font-weight: 700;
  cursor: pointer;
}

.mi-segmented button + button {
  border-left: 1px solid var(--mi-border);
}

.mi-segmented button.active {
  background: rgba(22, 217, 176, .12);
  color: var(--mi-accent);
}

.mi-control-spacer { flex: 1; }

.mi-toggle.active,
.mi-density.active {
  color: var(--mi-accent);
}

.mi-toggle-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: currentColor;
}

.mi-secondary-button {
  border: 1px solid var(--mi-border);
  border-radius: 3px;
}

.mi-secondary-button:disabled {
  opacity: .5;
  cursor: default;
}

.mi-command-strip {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 20px;
  padding: 0 5px;
  color: var(--mi-muted);
  font-size: 8px;
  white-space: nowrap;
  overflow: hidden;
}

.mi-command-strip span {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.mi-command-strip span:first-child {
  color: #9eb0b8;
  font-weight: 800;
}

.mi-instrument-strip {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
  gap: 5px;
  margin: 4px 0 6px;
}

.mi-instrument-card {
  min-width: 0;
  padding: 7px 8px;
  border: 1px solid var(--mi-border);
  border-radius: 3px;
  background: var(--mi-surface);
  color: var(--mi-text);
  text-align: left;
  cursor: pointer;
}

.mi-instrument-card:hover,
.mi-instrument-card.selected {
  border-color: rgba(22, 217, 176, .42);
  background: rgba(22, 217, 176, .035);
}

.mi-instrument-card-top,
.mi-instrument-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.mi-instrument-card-top {
  color: var(--mi-muted);
  font-size: 9px;
  font-weight: 700;
}

.mi-instrument-card-bottom {
  margin-top: 4px;
}

.mi-instrument-card-bottom strong {
  font-size: 14px;
  letter-spacing: -.02em;
}

.mi-sparkline {
  width: 58px;
  height: 24px;
  overflow: visible;
}

.mi-sparkline polyline {
  stroke: var(--mi-positive);
  stroke-width: 1.6;
}

.mi-sparkline.negative polyline {
  stroke: var(--mi-negative);
}

.mi-empty-strip,
.mi-empty {
  padding: 14px;
  border: 1px dashed var(--mi-border);
  color: var(--mi-muted);
  text-align: center;
}

.mi-overview-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.8fr) minmax(290px, .85fr);
  gap: 6px;
}

.mi-section-stack {
  display: grid;
  gap: 6px;
}

.mi-two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.mi-panel {
  min-width: 0;
  border: 1px solid var(--mi-border);
  border-radius: 3px;
  background: linear-gradient(180deg, rgba(13, 26, 35, .94), rgba(9, 18, 25, .94));
  box-shadow: 0 1px 0 rgba(255,255,255,.02) inset;
}

.mi-panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: 30px;
  padding: 5px 8px;
  border-bottom: 1px solid var(--mi-border);
}

.mi-panel-title {
  display: block;
  color: #d5e0e5;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .01em;
}

.mi-panel-subtitle {
  display: block;
  margin-top: 1px;
  color: var(--mi-muted);
  font-size: 8px;
}

.mi-chart-toolbar {
  display: flex;
  gap: 12px;
  height: 24px;
  align-items: center;
  padding: 0 8px;
  border-bottom: 1px solid var(--mi-border);
  color: var(--mi-muted);
  font-size: 8px;
  font-weight: 800;
}

.mi-chart-readout {
  display: flex;
  align-items: baseline;
  gap: 9px;
  padding: 6px 8px 2px;
}

.mi-chart-readout strong {
  font-size: 18px;
  letter-spacing: -.03em;
}

.mi-chart-readout span {
  color: var(--mi-muted);
  font-size: 8px;
}

.mi-chart {
  height: 215px;
  padding: 2px 8px;
}

.mi-chart svg {
  width: 100%;
  height: 100%;
  display: block;
}

.mi-grid-line {
  stroke: rgba(128,164,184,.12);
  stroke-width: .35;
  vector-effect: non-scaling-stroke;
}

.mi-chart-line {
  stroke: var(--mi-accent);
  stroke-width: 1.7;
}

.mi-chart-footer {
  display: flex;
  gap: 12px;
  padding: 4px 8px 6px;
  border-top: 1px solid var(--mi-border);
  color: var(--mi-muted);
  font-size: 7px;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
}

.mi-health-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.mi-health-cell {
  min-width: 0;
  padding: 12px 9px;
  border-right: 1px solid var(--mi-border);
}

.mi-health-cell:last-child { border-right: 0; }

.mi-health-cell span {
  display: block;
  color: var(--mi-muted);
  font-size: 7px;
  font-weight: 800;
}

.mi-health-cell strong {
  display: block;
  margin-top: 5px;
  color: #dbe7ed;
  font-size: 13px;
}

.mi-boundary-note,
.mi-unavailable-body {
  display: flex;
  gap: 7px;
  align-items: flex-start;
  padding: 8px;
  border-top: 1px solid var(--mi-border);
  color: var(--mi-muted);
  font-size: 8px;
  line-height: 1.45;
}

.mi-boundary-note svg,
.mi-unavailable-body svg {
  flex: 0 0 auto;
  color: var(--mi-amber);
}

.mi-table-panel {
  overflow: hidden;
}

.mi-table-wrap {
  overflow: auto;
}

.mi-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.mi-table th,
.mi-table td {
  padding: 5px 7px;
  border-bottom: 1px solid rgba(128,164,184,.10);
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mi-table th:first-child,
.mi-table td:first-child {
  text-align: left;
}

.mi-table th {
  color: var(--mi-muted);
  background: rgba(255,255,255,.018);
  font-size: 7px;
  font-weight: 800;
}

.mi-table td {
  color: #b9c9d0;
  font-size: 9px;
}

.mi-table tbody tr {
  cursor: pointer;
}

.mi-table tbody tr:hover,
.mi-table tbody tr.selected {
  background: rgba(22,217,176,.035);
}

.mi-capability-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.mi-capability-cell {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px;
  border-right: 1px solid var(--mi-border);
  border-bottom: 1px solid var(--mi-border);
}

.mi-capability-cell:nth-child(3n) { border-right: 0; }

.mi-capability-cell strong,
.mi-capability-cell span {
  display: block;
}

.mi-capability-cell strong {
  color: #cbd9df;
  font-size: 9px;
}

.mi-capability-cell div > span {
  margin-top: 2px;
  color: var(--mi-muted);
  font-size: 7px;
}

.mi-unavailable {
  min-height: 105px;
}

.mi-unavailable-body strong,
.mi-unavailable-body span {
  display: block;
}

.mi-unavailable-body strong {
  color: #c8d5da;
  font-size: 9px;
}

.mi-unavailable-body span {
  margin-top: 2px;
  color: var(--mi-muted);
}

.mi-feature-register {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  padding: 8px;
  border: 1px solid var(--mi-border);
  background: var(--mi-surface);
}

.mi-feature-register span {
  padding: 5px 7px;
  border: 1px solid var(--mi-border);
  border-radius: 2px;
  color: #aabdc5;
  font-size: 8px;
}

.mi-command-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
  padding: 7px;
}

.mi-command-grid button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 30px;
  border: 1px solid var(--mi-border);
  border-radius: 3px;
  background: rgba(255,255,255,.018);
  color: #9fb1ba;
  font-size: 8px;
  font-weight: 800;
  cursor: pointer;
}

.mi-command-grid button:hover:not(:disabled) {
  border-color: var(--mi-border-strong);
  color: var(--mi-text);
}

.mi-command-grid button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.mi-section-nav {
  display: flex;
  gap: 0;
  position: sticky;
  bottom: 0;
  z-index: 4;
  margin-top: 7px;
  padding: 3px;
  border: 1px solid var(--mi-border);
  background: rgba(7,16,23,.96);
  backdrop-filter: blur(8px);
  border-radius: 3px;
}

.mi-section-nav span {
  flex: 1;
  min-width: 0;
  padding: 5px 4px;
  color: var(--mi-muted);
  text-align: center;
  font-size: 7px;
  font-weight: 800;
  border-radius: 2px;
}

.mi-section-nav span.active {
  color: var(--mi-accent);
  background: rgba(22,217,176,.08);
}

.mi-compact .mi-chart {
  height: 185px;
}

.mi-compact .mi-instrument-card {
  padding: 5px 7px;
}

.mi-compact .mi-panel-heading {
  min-height: 27px;
}

@media (max-width: 1050px) {
  .mi-overview-grid,
  .mi-two-column {
    grid-template-columns: 1fr;
  }

  .mi-control-spacer {
    display: none;
  }

  .mi-control-bar {
    flex-wrap: wrap;
  }

  .mi-search {
    flex: 1;
  }
}

@media (max-width: 720px) {
  .mi-command-strip {
    display: none;
  }

  .mi-header-actions .mi-authority-chip {
    display: none;
  }

  .mi-capability-grid,
  .mi-health-grid,
  .mi-command-grid {
    grid-template-columns: 1fr 1fr;
  }

  .mi-capability-cell:nth-child(3n) {
    border-right: 1px solid var(--mi-border);
  }

  .mi-capability-cell:nth-child(2n) {
    border-right: 0;
  }

  .mi-chart-footer {
    overflow: auto;
  }
}
