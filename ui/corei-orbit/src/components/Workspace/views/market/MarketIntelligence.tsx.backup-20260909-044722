const MarketIntelligence: React.FC<MarketIntelligenceProps> = ({ section = 'overview' }) => {
  const instruments = useMarketStore((state) => state.instruments) as Record<string, Instrument>;
  const loading = useMarketStore((state) => state.loading);
  const error = useMarketStore((state) => state.error);
  const fetchData = useMarketStore((state) => state.fetchData);

  const symbols = Object.keys(instruments);
  const [selectedSymbol, setSelectedSymbol] = useState('');
  const [timeframe, setTimeframe] = useState('15m');
  const [search, setSearch] = useState('');
  const [autoRefresh, setAutoRefresh] = useState(false);
  const [compact, setCompact] = useState(true);
  const [showPanels, setShowPanels] = useState(true);

  useEffect(() => {
    if (!selectedSymbol && symbols.length) setSelectedSymbol(symbols[0]);
    if (selectedSymbol && !symbols.includes(selectedSymbol) && symbols.length) {
      setSelectedSymbol(symbols[0]);
    }
  }, [symbols, selectedSymbol]);

  const selectedData = instruments[selectedSymbol];

  const handleExport = () => {
    const payload = JSON.stringify(
      {
        exported_at: new Date().toISOString(),
        source: 'COREI Orbit market-data store',
        instruments,
      },
      null,
      2,
    );
    const blob = new Blob([payload], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = 'corei-market-intelligence-observations.json';
    anchor.click();
    URL.revokeObjectURL(url);
  };

  const handleFullscreen = () => {
    const element = document.querySelector('.market-intelligence-root');
    if (element && !document.fullscreenElement) {
      void (element as HTMLElement).requestFullscreen?.();
    } else if (document.fullscreenElement) {
      void document.exitFullscreen?.();
    }
  };

  const metadata = SECTION_META[section];

  return (
    <div className={`market-intelligence-root ${compact ? 'mi-compact' : ''}`}>
      <SectionHeader
        title={metadata.title}
        subtitle={metadata.subtitle}
        onRefresh={() => void fetchData()}
        loading={loading}
        onFullscreen={handleFullscreen}
      />

      <ControlBar
        symbols={symbols}
        selectedSymbol={selectedSymbol}
        setSelectedSymbol={setSelectedSymbol}
        timeframe={timeframe}
        setTimeframe={setTimeframe}
        search={search}
        setSearch={setSearch}
        autoRefresh={autoRefresh}
        setAutoRefresh={setAutoRefresh}
        compact={compact}
        setCompact={setCompact}
        onRefresh={() => void fetchData()}
        loading={loading}
        onTogglePanels={() => setShowPanels(!showPanels)}
      />

      <div className="mi-command-strip">
        <span><ShieldCheck size={11} /> MARKET DATA AUTHORITY</span>
        <span>Source: existing market-data service</span>
        <span>Timeframe: {timeframe}</span>
        <span>Selected: {selectedSymbol || '--'}</span>
        <span className={error ? 'mi-negative' : 'mi-positive'}>
          {error ? 'ERROR' : loading ? 'UPDATING' : 'READY'}
        </span>
      </div>

      {section === 'overview' && (
        <>
          <InstrumentStrip
            instruments={instruments}
            selectedSymbol={selectedSymbol}
            onSelect={setSelectedSymbol}
          />

          {showPanels && (
            <div className="mi-overview-grid">
              <PriceChart symbol={selectedSymbol} data={selectedData} timeframe={timeframe} />
              <MarketHealth instruments={instruments} loading={loading} error={error} />

              <MarketDataTable
                instruments={instruments}
                query={search}
                selectedSymbol={selectedSymbol}
                onSelect={setSelectedSymbol}
              />

              <CapabilityMatrix />

              <div className="mi-two-column">
                <CapabilityUnavailable
                  title="Technical / Structure"
                  description="RSI, MACD, moving averages, support/resistance, liquidity and order-book analytics must be supplied by governed backend feature services."
                />
                <CapabilityUnavailable
                  title="Trend / Volatility / Momentum"
                  description="Directional scores, volatility measurements, momentum state and multi-timeframe analytics are not fabricated in the browser."
                />
              </div>

              <div className="mi-two-column">
                <CapabilityUnavailable
                  title="Market Regime / Context"
                  description="Regime, context, confidence and transition state require the backend Market Intelligence state chain."
                />
                <CapabilityUnavailable
                  title="Historical / Replay / Lineage"
                  description="Replay and lineage controls remain disabled until the authoritative backend exposure is available."
                />
              </div>

              <OperatorControls onRefresh={() => void fetchData()} onExport={handleExport} />
            </div>
          )}
        </>
      )}

      {section === 'market-data' && (
        <div className="mi-section-stack">
          <InstrumentStrip instruments={instruments} selectedSymbol={selectedSymbol} onSelect={setSelectedSymbol} />
          <MarketDataTable instruments={instruments} query={search} selectedSymbol={selectedSymbol} onSelect={setSelectedSymbol} />
          <PriceChart symbol={selectedSymbol} data={selectedData} timeframe={timeframe} />
        </div>
      )}

      {section === 'market-health' && (
        <div className="mi-section-stack">
          <MarketHealth instruments={instruments} loading={loading} error={error} />
          <CapabilityUnavailable
            title="Feed Health / Freshness / Sequence Integrity"
            description="The UI will render feed health, latency, freshness, event rate and sequence integrity once those backend-authoritative fields are exposed."
          />
        </div>
      )}

      {ANALYTICS_SECTIONS.includes(section) && (
        <div className="mi-section-stack">
          <CapabilityUnavailable
            title={metadata.title}
            description={metadata.subtitle}
          />
          <div className="mi-feature-register">
            {section === 'technical' && ['RSI', 'MACD', 'EMA / SMA', 'VWAP', 'ATR', 'ADX', 'Bollinger Bands'].map((item) => (
              <span key={item}>{item}</span>
            ))}
            {section === 'structure' && ['Support / Resistance', 'Key Levels', 'Depth', 'Imbalance', 'Liquidity Zones', 'Sweeps', 'MTF Alignment'].map((item) => (
              <span key={item}>{item}</span>
            ))}
            {section === 'trend' && ['Direction', 'Strength', 'ADX', 'EMA Alignment', 'MTF Agreement', 'Trend Change'].map((item) => (
              <span key={item}>{item}</span>
            ))}
            {section === 'volatility' && ['ATR', 'Realized Volatility', 'Percentile', 'Expansion', 'Contraction', 'Spread Behaviour'].map((item) => (
              <span key={item}>{item}</span>
            ))}
            {section === 'momentum' && ['RSI', 'Momentum Score', 'Direction', 'Change', 'Overbought / Oversold', 'MTF Momentum'].map((item) => (
              <span key={item}>{item}</span>
            ))}
            {section === 'regime' && ['Current Regime', 'Confidence', 'Since', 'Transition', 'History', 'Context'].map((item) => (
              <span key={item}>{item}</span>
            ))}
          </div>
        </div>
      )}

      <nav className="mi-section-nav" aria-label="Market Intelligence sections">
        {SECTION_ORDER.map((item) => (
          <span key={item} className={item === section ? 'active' : ''}>
            {SECTION_META[item].short}
          </span>
        ))}
      </nav>
    </div>
  );
};

export default MarketIntelligence;
