  );
};

const PriceChart: React.FC<{
  symbol: string;
  data?: Instrument;
  timeframe: string;
}> = ({ symbol, data, timeframe }) => {
  const history = data?.history ?? [];
  const stats = useMemo(() => {
    if (!history.length) return null;
    const first = history[0];
    const last = history[history.length - 1];
    const min = Math.min(...history);
    const max = Math.max(...history);
    const delta = first ? ((last - first) / first) * 100 : 0;
    return { first, last, min, max, delta };
  }, [history]);

  const line = useMemo(() => {
    if (!history.length) return '';
    const min = Math.min(...history);
    const max = Math.max(...history);
    const range = max - min || 1;
    return history
      .map((value, index) => {
        const x = 12 + (index / Math.max(history.length - 1, 1)) * 96;
        const y = 12 + 70 - ((value - min) / range) * 70;
        return `${x.toFixed(2)},${y.toFixed(2)}`;
      })
      .join(' ');
  }, [history]);

  return (
    <section className="mi-panel mi-chart-panel">
      <div className="mi-panel-heading">
        <div>
          <span className="mi-panel-title">{symbol || 'Market'} · Price Observation</span>
          <span className="mi-panel-subtitle">Observed series · {timeframe}</span>
        </div>
        <div className="mi-chart-tools">
          <span className="mi-state mi-state-neutral">OBSERVED</span>
          <button className="mi-mini-button" type="button" title="Chart controls">
            <SlidersHorizontal size={12} />
          </button>
        </div>
      </div>

      <div className="mi-chart-toolbar">
        <span>O/H/L/C</span>
        <span>INDICATORS</span>
        <span>COMPARE</span>
        <span>DRAW</span>
        <span>DEPTH</span>
        <span>LINEAGE</span>
      </div>

      {stats ? (
        <>
          <div className="mi-chart-readout">
            <strong>{formatPrice(stats.last)}</strong>
            <span className={stats.delta >= 0 ? 'mi-positive' : 'mi-negative'}>
              {formatPercent(stats.delta)}
            </span>
            <span>H {formatPrice(stats.max)}</span>
            <span>L {formatPrice(stats.min)}</span>
            <span>N {history.length}</span>
          </div>
          <div className="mi-chart">
            <svg viewBox="0 0 120 94" preserveAspectRatio="none" role="img" aria-label={`${symbol} observed price series`}>
              {[15, 35, 55, 75].map((y) => (
                <line key={y} x1="12" x2="108" y1={y} y2={y} className="mi-grid-line" />
              ))}
              {[12, 36, 60, 84, 108].map((x) => (
                <line key={x} x1={x} x2={x} y1="12" y2="82" className="mi-grid-line" />
              ))}
              <polyline points={line} className="mi-chart-line" fill="none" vectorEffect="non-scaling-stroke" />
            </svg>
          </div>
          <div className="mi-chart-footer">
            <span>OBSERVATION COUNT {history.length}</span>
            <span>FIRST {formatPrice(stats.first)}</span>
            <span>LAST {formatPrice(stats.last)}</span>
            <span>SOURCE: EXISTING MARKET-DATA SERVICE</span>
          </div>
        </>
      ) : (
        <div className="mi-empty">No history is available for the selected instrument.</div>
      )}
    </section>
  );
};

const MarketDataTable: React.FC<{
  instruments: Record<string, Instrument>;
  query: string;
  selectedSymbol: string;
  onSelect: (symbol: string) => void;
}> = ({ instruments, query, selectedSymbol, onSelect }) => {
  const rows = useMemo(
    () =>
      Object.entries(instruments)
        .filter(([symbol]) => symbol.toLowerCase().includes(query.toLowerCase()))
        .sort((a, b) => Math.abs(b[1].change) - Math.abs(a[1].change)),
    [instruments, query],
  );

  return (
    <section className="mi-panel mi-table-panel">
      <div className="mi-panel-heading">
        <div>
          <span className="mi-panel-title">Market Data Matrix</span>
          <span className="mi-panel-subtitle">Current observations available to Orbit</span>
        </div>
        <span className="mi-count">{rows.length} instruments</span>
      </div>
      <div className="mi-table-wrap">
        <table className="mi-table">
          <thead>
            <tr>
              <th>INSTRUMENT</th>
              <th>LAST</th>
              <th>CHANGE</th>
              <th>OBSERVATIONS</th>
              <th>SERIES LOW</th>
              <th>SERIES HIGH</th>
              <th>STATE</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(([symbol, data]) => {
              const history = data.history ?? [];
              return (
                <tr
                  key={symbol}
                  className={selectedSymbol === symbol ? 'selected' : ''}
                  onClick={() => onSelect(symbol)}
                >
                  <td><strong>{symbol}</strong></td>
                  <td>{formatPrice(data.price)}</td>
                  <td className={data.change >= 0 ? 'mi-positive' : 'mi-negative'}>
                    {formatPercent(data.change)}
                  </td>
                  <td>{history.length || 0}</td>
                  <td>{history.length ? formatPrice(Math.min(...history)) : '--'}</td>
                  <td>{history.length ? formatPrice(Math.max(...history)) : '--'}</td>
                  <td><span className="mi-state mi-state-live">AVAILABLE</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {!rows.length && <div className="mi-empty">No instruments match the current search.</div>}
      </div>
    </section>
  );
};

