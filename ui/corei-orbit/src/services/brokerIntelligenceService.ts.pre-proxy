// src/services/brokerIntelligenceService.ts
import { useBrokerIntelligenceStore } from '../store/brokerIntelligenceStore';
import type { BrokerProvider, BrokerAccount, BrokerCredential } from '../types/brokerIntelligence';
import { toast } from 'sonner';

// FORCE localhost for browser access (Requires port-forward running)
// Change this to your actual external IP if using a different setup
const API_BASE = 'http://192.168.1.10:8003';

const ENDPOINTS = {
  providers: `${API_BASE}/broker/providers`,
  accounts: `${API_BASE}/broker/accounts`,
  credentials: `${API_BASE}/broker/credentials`,
  connectAccount: (id: string) => `${API_BASE}/broker/accounts/${id}/connect`,
  disconnectAccount: (id: string) => `${API_BASE}/broker/accounts/${id}/disconnect`,
  enableProvider: (id: string) => `${API_BASE}/broker/providers/${id}/enable`,
  disableProvider: (id: string) => `${API_BASE}/broker/providers/${id}/disable`,
  rotateCredential: (id: string) => `${API_BASE}/broker/credentials/${id}/rotate`,
  refreshAccount: (id: string) => `${API_BASE}/broker/accounts/${id}/refresh`,
};

async function request<T>(url: string, options?: RequestInit): Promise<T> {
  const response = await fetch(url, {
    headers: { 'Content-Type': 'application/json' },
    ...options,
  });

  if (!response.ok) {
    throw new Error(`API Error: ${response.status} ${response.statusText}`);
  }
  return response.json() as Promise<T>;
}

export const brokerIntelligenceService = {
  async fetchAll() {
    const store = useBrokerIntelligenceStore.getState();
    store.setLoading(true);
    store.setError(null);

    try {
      const [providers, accounts, credentials] = await Promise.all([
        request<BrokerProvider[]>(ENDPOINTS.providers),
        request<BrokerAccount[]>(ENDPOINTS.accounts),
        request<BrokerCredential[]>(ENDPOINTS.credentials),
      ]);
      store.setProviders(providers);
      store.setAccounts(accounts);
      store.setCredentials(credentials);
      store.setLastRefresh(Date.now());
    } catch (error: any) {
      store.setError(error.message);
      toast.error(`Failed to fetch broker data: ${error.message}`);
    } finally {
      store.setLoading(false);
    }
  },
  async connectAccount(accountId: string) {
    const store = useBrokerIntelligenceStore.getState();
    try {
      await request(ENDPOINTS.connectAccount(accountId), { method: 'POST' });
      store.updateAccount(accountId, { connected: true, health: 'CONNECTED' });
      toast.success(`Account ${accountId} connected`);
    } catch (err: any) { toast.error(`Connect failed: ${err.message}`); }
  },
  async disconnectAccount(accountId: string) {
    const store = useBrokerIntelligenceStore.getState();
    try {
      await request(ENDPOINTS.disconnectAccount(accountId), { method: 'POST' });
      store.updateAccount(accountId, { connected: false, health: 'DISCONNECTED' });
      toast.success(`Account ${accountId} disconnected`);
    } catch (err: any) { toast.error(`Disconnect failed: ${err.message}`); }
  },
  async enableProvider(providerId: string) {
    const store = useBrokerIntelligenceStore.getState();
    try {
      await request(ENDPOINTS.enableProvider(providerId), { method: 'POST' });
      store.updateProvider(providerId, { enabled: true });
      toast.success(`Provider ${providerId} enabled`);
    } catch (err: any) { toast.error(`Enable failed: ${err.message}`); }
  },
  async disableProvider(providerId: string) {
    const store = useBrokerIntelligenceStore.getState();
    try {
      await request(ENDPOINTS.disableProvider(providerId), { method: 'POST' });
      store.updateProvider(providerId, { enabled: false });
      toast.success(`Provider ${providerId} disabled`);
    } catch (err: any) { toast.error(`Disable failed: ${err.message}`); }
  },
  async rotateCredential(credentialId: string) {
    const store = useBrokerIntelligenceStore.getState();
    try {
      await request(ENDPOINTS.rotateCredential(credentialId), { method: 'POST' });
      store.updateCredential(credentialId, { status: 'ROTATING' });
      toast.success(`Credential ${credentialId} rotation triggered`);
    } catch (err: any) { toast.error(`Rotation failed: ${err.message}`); }
  },
  async refreshAccount(accountId: string) {
    try {
      await request(ENDPOINTS.refreshAccount(accountId), { method: 'POST' });
      toast.success(`Account ${accountId} refreshed`);
      this.fetchAll();
    } catch (err: any) { toast.error(`Refresh failed: ${err.message}`); }
  },
};
