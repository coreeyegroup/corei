{
  "name": "corei-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build-docs && concurrently \"vite --host 0.0.0.0 --port 5176\" \"pnpm watch-docs\"",
    "build": "pnpm build-docs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build-docs": "tsx scripts/build-docs.ts",
    "watch-docs": "tsx scripts/watch-docs.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flexsearch": "^0.7.43",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.527.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.0.1",
    "react-router-dom": "^7.7.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "fast-glob": "^3.3.3",
    "glob": "^11.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
